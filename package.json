{
  "name": "awslabs.aws-documentation-mcp-server",
  "version": "1.1.1",
  "description": "An AWS Labs Model Context Protocol (MCP) server for AWS Documentation",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "awslabs.aws-documentation-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "node --watch dist/index.js",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "aws",
    "documentation",
    "server"
  ],
  "author": "Amazon Web Services",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "volta": {
    "node": "24.3.0",
    "npm": "11.4.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.15.1",
    "@types/jsdom": "21.1.7",
    "cheerio": "1.1.0",
    "jsdom": "26.1.0",
    "turndown": "7.2.0",
    "uuid": "11.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.1",
    "@types/node": "24.0.13",
    "@types/turndown": "5.0.5",
    "@types/uuid": "10.0.0",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  },
  "directories": {
    "doc": "docs"
  },
  "type": "module"
}
